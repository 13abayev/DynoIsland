{
  "name": "island",
  "version": "0.4.0",
  "private": true,
  "description": "A Dynamic Island for Windows: all your AI sessions in one place, with reminders.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup.ps1",
